{
    "name": "functions",
    "scripts": {
        "build": "tsc",
        "test": "npm run build && node test/shift.test.js && node test/dashboard.test.js && node test/dashboard.edge.test.js && node test/auth.test.js && node test/backfill.test.js && node test/dedupe.test.js",
        "backfill:specs": "npm run build && node lib/scripts/backfill_bottle_specs.js",
        "serve": "npm run build && firebase emulators:start --only functions",
        "shell": "npm run build && firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "logs": "firebase functions:log",
        "audit:duplicates": "npm run build && node lib/scripts/dedupe_catalog.js",
        "dedupe:catalog": "npm run build && node lib/scripts/dedupe_catalog.js --merge"
    },
    "engines": {
        "node": "22"
    },
    "main": "lib/index.js",
    "dependencies": {
        "firebase-admin": "^11.8.0",
        "firebase-functions": "^4.3.1",
        "express": "^4.18.2",
        "cors": "^2.8.5",
        "jsonwebtoken": "^9.0.0",
        "bcryptjs": "^2.4.3",
        "dotenv": "^16.0.3",
        "axios": "^1.4.0",
        "moment": "^2.29.4",
        "@sendgrid/mail": "^7.7.0",
        "stripe": "^12.0.0"
    },
    "devDependencies": {
        "typescript": "^4.9.0",
        "firebase-functions-test": "^3.1.0",
        "@types/express": "^4.17.17",
        "@types/cors": "^2.8.13",
        "@types/jsonwebtoken": "^9.0.2",
        "@types/bcryptjs": "^2.4.2"
    },
    "private": true
}
