# Backend-only secrets. Never prefix with VITE_ and never place in smartbar-client/.
# Copy to .env and fill in real values. .env is gitignored.

# JWT signing secret for user and device tokens.
SECRET_TOKEN=

# Google Gemini API key, used server-side for barcode enrichment in
# src/productLookup.ts. Must not be shipped to the web or mobile client.
GEMINI_API_KEY=
