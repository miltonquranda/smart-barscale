{
    "functions": {
        "source": "smartbar-functions/functions",
        "predeploy": "npm --prefix \"$RESOURCE_DIR\" run build"
    },
    "hosting": [
        {
            "target": "app",
            "public": "smartbar-client/dist",
            "ignore": [
                "firebase.json",
                "**/.*",
                "**/node_modules/**"
            ],
            "rewrites": [
                {
                    "source": "/api/**",
                    "function": "api"
                },
                {
                    "source": "/",
                    "destination": "/index.html"
                },
                {
                    "source": "**",
                    "destination": "/app.html"
                }
            ]
        },
        {
            "target": "landing",
            "public": "landing-page",
            "ignore": [
                "firebase.json",
                "**/.*",
                "**/node_modules/**"
            ]
        }
    ],
    "emulators": {
        "functions": {
            "port": 5001
        },
        "firestore": {
            "port": 8080
        },
        "hosting": {
            "port": 5002
        },
        "ui": {
            "enabled": true
        }
    }
}